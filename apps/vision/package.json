{
  "name": "@abrxs/vision",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "cli": "tsx cli/vision-cli.ts",
    "pro:cli": "tsx cli/professional-cli.ts",
    "smoke": "tsx cli/vision-cli.ts smoke",
    "mcp": "tsx mcp/server.ts",
    "mcp:smoke": "tsx mcp/smoke.ts",
    "pro:mcp": "tsx mcp/professional-server.ts",
    "pro:mcp:smoke": "tsx mcp/professional-smoke.ts",
    "icon": "tauri icon src-tauri/icons/app-icon.svg",
    "desktop:prepare": "npm run icon",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:check": "npm run desktop:prepare && cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "npm run desktop:prepare && tauri build"
  },
  "dependencies": {
    "@abrxs/design-system": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}